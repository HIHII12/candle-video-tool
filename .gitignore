# Dependencies and downloaded runtimes/models
node_modules/
video-engine/vendor/

# Rendered media and generated reports
video-engine/out/

# Local environment and credentials
.env
.env.*
!.env.example
tool/.env
tool/.env.*
!tool/.env.example
tool-app/node_modules/
tool-app/dist/
tool-app/data/

# Generated run data, caches, and temporary files
video-engine/src/data/run_*.json
video-engine/public/voice/showcase-*
__pycache__/
*.py[cod]
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# Du an dang lam do - CAN di theo khi doi may (previews/*.wav tao lai duoc nen van chan)
!tool-app/data/
!tool-app/data/jobs.json
!tool-app/data/projects/
!tool-app/data/projects/**
tool-app/data/previews/

# Catalogue runs generate one config per video; they are rebuilt from the seed.
# The locale prefix was added when the Vietnam track landed, so the old pattern
# stopped matching and every run left a dozen modified files in the diff.
video-engine/src/data/batch_candle-*-v*.json
video-engine/src/data/batch_*-candle-*-v*.json
video-engine/src/data/batch_*-compare-*-v*.json
# The quiz plan writes one of these per video; they are generator output, not
# source, and 100 of them per run is not a diff anybody should have to read.
video-engine/src/data/batch_*-quiz-*.json
video-engine/src/data/batch_*-nen-*-v*.json
video-engine/src/data/batch_*-sosanh-*-v*.json
video-engine/src/data/_compare.json
video-engine/src/data/_probe.json
video-engine/out/qa/

# Configs stamped for one run; the sources they copy are checked in.
video-engine/src/data/_run/
