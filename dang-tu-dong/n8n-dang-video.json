{
  "name": "Dang video tu dong - 2 kenh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 8,13,20 * * *" }
          ]
        }
      },
      "id": "cron",
      "name": "Lich 8h 13h 20h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-620, 300]
    },
    {
      "parameters": {
        "jsCode": "// Doi mot buoc chay = mot bai cho MOI kenh.\n// Tach ra hai nhanh ngay tu day, de kenh nay hong khong keo kenh kia dung.\nreturn [{ json: { kenh: 'gf' } }, { json: { kenh: 'vt' } }];"
      },
      "id": "hai-kenh",
      "name": "Hai kenh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 300]
    },
    {
      "parameters": {
        "command": "=cd {{ $env.THU_MUC_TOOL }} && ls lich/hang-doi/{{ $json.kenh }}-*.json 2>/dev/null | head -1"
      },
      "id": "lay-bai",
      "name": "Lay bai ke tiep",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-180, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.stdout.trim() }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "con-bai",
      "name": "Con bai khong?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [40, 300]
    },
    {
      "parameters": {
        "command": "=cat \"{{ $json.stdout.trim() }}\""
      },
      "id": "doc-bai",
      "name": "Doc thong tin bai",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [260, 200]
    },
    {
      "parameters": {
        "jsCode": "// stdout la JSON bai viet. Giu nguyen duong dan file goc de buoc sau\n// con biet phai chuyen file nao sang da-dang.\nconst bai = JSON.parse($json.stdout);\nbai.the_json = $('Lay bai ke tiep').item.json.stdout.trim();\nreturn [{ json: bai }];"
      },
      "id": "phan-tich",
      "name": "Phan tich",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "filePath": "={{ $json.duong_dan }}",
        "options": { "dataPropertyName": "video" }
      },
      "id": "doc-video",
      "name": "Doc file mp4",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [700, 200]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Phan tich').item.json.tieu_de }}",
        "regionCode": "VN",
        "categoryId": "27",
        "options": {
          "description": "={{ $('Phan tich').item.json.mo_ta }}\n\n{{ $('Phan tich').item.json.hashtag }}",
          "privacyStatus": "public",
          "selfDeclaredMadeForKids": false
        }
      },
      "id": "youtube",
      "name": "Dang YouTube",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [920, 200],
      "credentials": {},
      "notes": "Gan credential theo kenh: GoldFather FX hoac Van Thang Invest. Dung HAI Google Cloud project rieng — quota 10.000/ngay tinh theo project, moi upload ton 1.600, tuc ~6 video/ngay/project. Chung project thi hai kenh chia doi tran do."
    },
    {
      "parameters": {
        "command": "=cd {{ $env.THU_MUC_TOOL }} && mv \"{{ $('Phan tich').item.json.the_json }}\" lich/da-dang/"
      },
      "id": "danh-dau",
      "name": "Chuyen sang da-dang",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1140, 200],
      "notes": "Chuyen file, khong sua file. Mot buoc nay hoac thanh cong hoac khong — khong co trang thai lung chung neu may tat giua chung."
    },
    {
      "parameters": {
        "command": "=cd {{ $env.THU_MUC_TOOL }} && mv \"{{ $('Phan tich').item.json.the_json }}\" lich/loi/"
      },
      "id": "danh-dau-loi",
      "name": "Chuyen sang loi",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1140, 400],
      "notes": "Bai that bai KHONG nam lai hang-doi: neu nam lai, lan chay sau lai lay dung no va hong y het, hang doi dung tai cho mai mai. Xem xong thi keo nguoc ve hang-doi bang tay."
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✅ {{ $('Phan tich').item.json.kenh === 'gf' ? 'GoldFather FX' : 'Van Thang Invest' }}\n{{ $('Phan tich').item.json.tieu_de }}\nCon lai trong hang doi: xem lich/hang-doi",
        "additionalFields": {}
      },
      "id": "bao-ok",
      "name": "Bao da dang",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1360, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=❌ Dang HONG — {{ $('Phan tich').item.json.kenh }}\n{{ $('Phan tich').item.json.ma }}\nBai da chuyen sang lich/loi/",
        "additionalFields": {}
      },
      "id": "bao-loi",
      "name": "Bao loi",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1360, 400]
    }
  ],
  "connections": {
    "Lich 8h 13h 20h": { "main": [[{ "node": "Hai kenh", "type": "main", "index": 0 }]] },
    "Hai kenh": { "main": [[{ "node": "Lay bai ke tiep", "type": "main", "index": 0 }]] },
    "Lay bai ke tiep": { "main": [[{ "node": "Con bai khong?", "type": "main", "index": 0 }]] },
    "Con bai khong?": { "main": [[{ "node": "Doc thong tin bai", "type": "main", "index": 0 }], []] },
    "Doc thong tin bai": { "main": [[{ "node": "Phan tich", "type": "main", "index": 0 }]] },
    "Phan tich": { "main": [[{ "node": "Doc file mp4", "type": "main", "index": 0 }]] },
    "Doc file mp4": { "main": [[{ "node": "Dang YouTube", "type": "main", "index": 0 }]] },
    "Dang YouTube": {
      "main": [[{ "node": "Chuyen sang da-dang", "type": "main", "index": 0 }]],
      "error": [[{ "node": "Chuyen sang loi", "type": "main", "index": 0 }]]
    },
    "Chuyen sang da-dang": { "main": [[{ "node": "Bao da dang", "type": "main", "index": 0 }]] },
    "Chuyen sang loi": { "main": [[{ "node": "Bao loi", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
