# Copy to tool/.env and fill in. Never commit the real file.
# Captions are the only step that uses a model; everything else is arithmetic.

LLM_BASE_URL=https://api.shopaikey.com
LLM_API_KEY=sk-your-new-key-here
LLM_MODEL=deepseek-chat

# Verify your key before running a batch:
#   curl -s $LLM_BASE_URL/v1/models -H "Authorization: Bearer $LLM_API_KEY" | head -c 300
